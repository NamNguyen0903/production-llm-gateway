# Application
APP_NAME=Production LLM Gateway
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/v1
REQUEST_ID_HEADER=X-Request-ID

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/llm_gateway

# Redis
REDIS_URL=redis://localhost:6379/0

# Provider routing
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=gemini

# Provider credentials
# Leave empty in the committed example file.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Used later to produce API-key HMAC digests.
API_KEY_HMAC_SECRET=

# Reliability
LLM_ATTEMPT_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_BACKOFF_BASE_SECONDS=0.5

# Cache
CACHE_TTL_SECONDS=600

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60